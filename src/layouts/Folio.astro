---
import "../styles/world.css";
import Icon from "../components/Icon.astro";
import InfraRegistry from "../components/InfraRegistry.astro";
import { useUi, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = useUi(locale);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = { pt: `${base}/`, en: `${base}/en/` };
const canonical = new URL(home[locale], Astro.site ?? "https://shishiv.github.io");
const sourceRoot =
  "https://github.com/shishiv/infra-examples/blob/c0469a25a6602399ba2107cee5d42d48d12e4c31/README.md";
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(home.pt, canonical).href} />
    <link rel="alternate" hreflang="en" href={new URL(home.en, canonical).href} />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical.href} />
    <meta name="theme-color" content="#4b426f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Petrona:ital,wght@0,400;1,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>

    <main class="folio" id="main-content">
      <header class="masthead">
        <div class="masthead-meta">
          <p class="eyebrow">{copy.eyebrow}</p>
          <a class="source-shortcut" href={sourceRoot} rel="noopener noreferrer">infra-examples ↗</a>
        </div>

        <div class="hero-grid">
          <div class="hero-heading">
            <h1>myke matos</h1>
            <p class="hero-title">{copy.heroTitle}</p>
          </div>
          <div class="hero-copy">
            <p>{copy.heroCopy}</p>
            <p class="source-note">
              <span>{copy.sourceIntro}</span>
              <a href={sourceRoot} rel="noopener noreferrer">{copy.sourceDescription}</a>
            </p>
          </div>
        </div>

        <nav class="site-nav" aria-label={copy.primaryNav}>
          <a href="#mapa">{copy.mapNav}</a>
          <a href="#limites">{copy.limitsNav}</a>
          <a href="#contato">{copy.contactNav}</a>
          <span class="nav-divider" aria-hidden="true"></span>
          <a href={home.pt} hreflang="pt-BR" aria-current={locale === "pt" ? "page" : undefined}>pt</a>
          <a href={home.en} hreflang="en" aria-current={locale === "en" ? "page" : undefined}>en</a>
        </nav>
      </header>

      <div class="folio-body">
        <InfraRegistry locale={locale} />

        <section class="limits" id="limites" aria-labelledby="limits-title">
          <header class="section-heading section-heading-compact">
            <p class="section-kicker">{copy.limitsKicker}</p>
            <h2 id="limits-title">{copy.limitsTitle}</h2>
            <p class="section-intro">{copy.limitsIntro}</p>
          </header>

          <div class="limits-list">
            {
              copy.limitations.map((limitation) => (
                <article class="limit-item">
                  <h3>{limitation.title}</h3>
                  <p>{limitation.text}</p>
                  <a href={limitation.sourceHref} rel="noopener noreferrer">
                    {limitation.sourceLabel} <span aria-hidden="true">↗</span>
                  </a>
                </article>
              ))
            }
          </div>
        </section>
      </div>

      <footer class="colophon" id="contato" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="section-kicker">{copy.contactKicker}</p>
          <h2 id="contact-title">{copy.contactTitle}</h2>
          <p>{copy.contactCopy}</p>
        </div>

        <div class="contact-links">
          <a href="mailto:myke@triangulotec.com.br">
            <Icon name="mail" />
            <span>{copy.emailLabel}</span>
          </a>
          <a href="https://github.com/shishiv" rel="me noopener noreferrer">
            <Icon name="github" />
            <span>{copy.githubLabel}</span>
          </a>
          <a href="https://linkedin.com/in/mykematos" rel="me noopener noreferrer">
            <Icon name="linkedin" />
            <span>{copy.linkedinLabel}</span>
          </a>
        </div>

        <div class="footer-meta">
          <span>{copy.footerNote}</span>
          <span aria-hidden="true">·</span>
          <a href={sourceRoot} rel="noopener noreferrer">infra-examples</a>
        </div>
      </footer>
    </main>
  </body>
</html>
