---
import rawInfra from "../data/infra.json";
import { useUi, type Locale } from "../i18n/ui";

interface LocalizedText {
  pt: string;
  en: string;
}

interface InfraExample {
  id: string;
  name: string;
  title: LocalizedText;
  summary: LocalizedText;
  decisions: {
    pt: string[];
    en: string[];
  };
  boundary: LocalizedText;
  source: {
    label: string;
    href: string;
  };
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = useUi(locale);
const examples = rawInfra as InfraExample[];

function localized(value: LocalizedText, language: Locale) {
  return value[language];
}
---

<section class="registry" id="mapa" aria-labelledby="registry-title">
  <header class="section-heading">
    <p class="section-kicker">{copy.mapKicker}</p>
    <h2 id="registry-title">{copy.mapTitle}</h2>
    <p class="section-intro">{copy.mapIntro}</p>
  </header>

  <div class="example-list">
    {
      examples.map((example) => (
        <article class="example" id={`example-${example.id}`}>
          <div class="example-marker" aria-hidden="true"></div>
          <div class="example-content">
            <header class="example-heading">
              <p class="example-name">{example.name}</p>
              <h3>{localized(example.title, locale)}</h3>
            </header>

            <p class="example-summary">{localized(example.summary, locale)}</p>

            <div class="decision-block">
              <h4>{copy.decisionsLabel}</h4>
              <ul>
                {example.decisions[locale].map((decision) => <li>{decision}</li>)}
              </ul>
            </div>

            <p class="boundary">
              <span>{copy.boundaryLabel}:</span>
              {localized(example.boundary, locale)}
            </p>

            <a class="source-link" href={example.source.href} rel="noopener noreferrer">
              <span>{copy.readSource}</span>
              <span class="source-path">{example.source.label}</span>
              <span class="source-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
