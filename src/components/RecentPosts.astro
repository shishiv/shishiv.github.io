---
import { getCollection } from "astro:content";
import { useUi, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = useUi(locale);

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft && post.data.lang === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat(locale === "pt" ? "pt-BR" : "en", {
  month: "short",
  year: "numeric",
});
---

<section class="posts" aria-labelledby="posts-title">
  <h2 id="posts-title">{copy.posts}</h2>

  {
    posts.length > 0 ? (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
          </li>
        ))}
      </ul>
    ) : (
      <p class="posts-empty">{copy.postsEmpty}</p>
    )
  }
</section>
