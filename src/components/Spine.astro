---
import rawEvents from "../data/events.json";
import {
  placeCluster,
  placeEvents,
  ribbonPath,
  SPINE_DEFAULTS,
  t,
  type PortfolioEvent,
} from "../lib/spine";
import { useUi, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = useUi(locale);

const events = placeEvents(rawEvents as PortfolioEvent[]);
const { top, bottom } = SPINE_DEFAULTS;

const VIEW_W = 660;
const VIEW_H = 900;
const LABEL_OFFSET = 68;
const HUB_OFFSET = 98;

const path = ribbonPath(top, bottom);

const years = [...new Set(events.map((event) => event.date.slice(0, 4)))];
const firstYear = years[0];
const lastYear = years[years.length - 1];

// o fim da fita solta fio. cada filamento diverge e perde opacidade.
const frayOrigin = events[events.length - 1]?.x ?? 92;
const fray = [
  { d: `M${frayOrigin - 4},${bottom} C${frayOrigin - 3},${bottom + 28} ${frayOrigin - 10},${bottom + 52} ${frayOrigin - 24},${bottom + 82}`, w: 1.5, o: 0.68 },
  { d: `M${frayOrigin - 1},${bottom} C${frayOrigin + 1},${bottom + 30} ${frayOrigin + 3},${bottom + 58} ${frayOrigin - 2},${bottom + 88}`, w: 1.2, o: 0.54 },
  { d: `M${frayOrigin + 2},${bottom} C${frayOrigin + 7},${bottom + 28} ${frayOrigin + 18},${bottom + 54} ${frayOrigin + 36},${bottom + 76}`, w: 1.2, o: 0.58 },
  { d: `M${frayOrigin + 4},${bottom} C${frayOrigin + 12},${bottom + 26} ${frayOrigin + 34},${bottom + 46} ${frayOrigin + 64},${bottom + 58}`, w: 1, o: 0.4 },
  { d: `M${frayOrigin + 5},${bottom} C${frayOrigin + 16},${bottom + 24} ${frayOrigin + 46},${bottom + 36} ${frayOrigin + 84},${bottom + 42}`, w: 0.85, o: 0.26 },
];
---

<svg
  viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
  aria-hidden="true"
  preserveAspectRatio="xMidYMin meet"
>
  <line class="rule-line" x1="26" y1={top - 38} x2="26" y2={bottom + 36} />
  <text class="t-year" x="26" y={top - 44} text-anchor="middle">{firstYear}</text>
  <text class="t-year" x="26" y={bottom + 52} text-anchor="middle">{lastYear}</text>

  <g class="ribbon-draw"><path class="ribbon" d={path} /></g>

  <g class="fray-draw">{fray.map((f) => <path class="fray" d={f.d} stroke-width={f.w} opacity={f.o} />)}</g>
  <text class="t-tech" x={frayOrigin + 104} y={bottom + 48}>{copy.fray}</text>

  {
    events.map((event, index) => {
      const labelX = event.x + LABEL_OFFSET;
      const title = t(event.title, locale);
      const tech = t(event.tech, locale);
      const meta = event.meta ? t(event.meta, locale) : null;

      if (!event.open) {
        const body = (
          <g class="event" style={`--i:${index}`}>
            <line class="crease" x1={event.x - 14} y1={event.y} x2={event.x + 14} y2={event.y} />
            <circle class="knot-on" cx={event.x} cy={event.y} r="5" />
            <line class="leader" x1={event.x + 8} y1={event.y} x2={labelX - 8} y2={event.y} />
            <text class="t-title" x={labelX} y={event.y - 4}>{title}</text>
            <text class="t-tech" x={labelX} y={event.y + 12}>{tech}</text>
            {meta && <text class="t-meta" x={labelX} y={event.y + 26}>{meta}</text>}
          </g>
        );
        return event.href ? (
          <a href={event.href} rel="noopener" class="event-link">{body}</a>
        ) : (
          body
        );
      }

      const hubX = event.x + HUB_OFFSET;
      const cluster = placeCluster(event, hubX, event.y);
      const byId = new Map(cluster.map((node) => [node.id, node]));

      return (
        <g class="event" style={`--i:${index}`}>
          <line class="crease" x1={event.x - 15} y1={event.y} x2={event.x + 15} y2={event.y} />
          <circle class="knot-open" cx={event.x} cy={event.y} r="8" />
          <circle class="knot" cx={event.x} cy={event.y} r="3.5" />
          <line class="leader" x1={event.x + 10} y1={event.y} x2={hubX - 10} y2={event.y} />
          <circle class="knot" cx={hubX} cy={event.y} r="6" />
          <text class="t-hub" x={hubX - 8} y={event.y - 24}>{title}</text>
          <text class="t-tech" x={hubX - 8} y={event.y - 11}>{tech}</text>

          {
            cluster.map((node) => {
              const source = node.from ? byId.get(node.from) : null;
              const x1 = source ? source.x + 7 : hubX + 7;
              const y1 = source ? source.y : event.y;
              const corridor = node.x - 26;
              const d =
                Math.abs(y1 - node.y) < 0.5
                  ? `M${x1},${y1} H${node.x - 7}`
                  : `M${x1},${y1} H${corridor} V${node.y} H${node.x - 7}`;
              return <path class={node.checkable ? "edge-checkable" : "edge"} d={d} />;
            })
          }

          {
            cluster.map((node) => {
              const inner = (
                <g class="clusternode">
                  <circle class="knot" cx={node.x} cy={node.y} r={node.checkable ? 5.5 : 4} />
                  <text class="t-node" x={node.x - 7} y={node.y - 22}>{t(node.title, locale)}</text>
                  <text class="t-tech" x={node.x - 7} y={node.y - 10}>{t(node.tech, locale)}</text>
                </g>
              );
              return node.href ? (
                <a href={node.href} rel="noopener" class="clusternode-link">{inner}</a>
              ) : (
                inner
              );
            })
          }

        </g>
      );
    })
  }
</svg>
